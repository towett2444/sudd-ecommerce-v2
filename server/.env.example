PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public address of this API (used for uploaded image links and the M-Pesa callback). Leave empty on localhost.
API_PUBLIC_URL=

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account, created on start if this email has no account yet.
# (npm run setup fills these in with a random password.)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Product images: ImageKit if set, otherwise saved in server/uploads.
IMAGEKIT_PRIVATE_KEY=

# Fill an empty store with sample products (not in production). Set to false to turn off.
SEED_SAMPLE_PRODUCTS=true

# ---------- M-Pesa (Safaricom Daraja, "M-Pesa Express" / STK push) ----------
# Without these, M-Pesa runs in TEST MODE (no real money). Get keys at https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or (for Buy Goods) the Head Office / store number; sandbox: 174379
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till). For a Till, set MPESA_PARTY_B to the till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Where Safaricom sends payment results (must be public https). Optional: payments are also confirmed by asking Safaricom.
MPESA_CALLBACK_URL=
# Random secret added to the callback URL so others can't fake callbacks.
MPESA_CALLBACK_TOKEN=

# ---------- Card payments (Paystack) ----------
# Without this, cards run in TEST MODE (no card details collected). Get a key at https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=

# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx).
TRUST_PROXY=
